# Copy to .env (local) and add the same two variables in your hosting provider (e.g. Vercel → Settings → Environment Variables).
# Supabase → Project Settings → API. The anon key is public by design; writes are protected by the policies in supabase/schema.sql.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
